# Listener for both the JSON API and the protected origin reverse proxy.
PORT=8080
ORIGIN_SERVER=http://localhost:4000

# Redis provides proxy counters, temporary IP blocks and admin sessions.
REDIS_URL=redis://127.0.0.1:6379

# MongoDB stores viewer accounts and security events. Events expire after EVENT_RETENTION_DAYS.
MONGODB_URI=mongodb://127.0.0.1:27017/anti_cloudflare
EVENT_RETENTION_DAYS=30

# Create the password hash interactively with: npm run create-admin-hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# Comma-separated exact browser origins allowed to call the JSON API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenRouter-backed security Q&A assistant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Keep zero unless the backend is behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Login endpoint: 10 attempts in a 15-minute fixed window per client IP.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900

# Protected reverse-proxy traffic: 30 requests in 60 seconds, then block for 5 minutes.
PROXY_RATE_LIMIT=30
PROXY_RATE_WINDOW_SECONDS=60
PROXY_BLOCK_SECONDS=300
